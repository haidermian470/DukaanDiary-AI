# DukaanDiary AI backend configuration
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. NEVER commit real keys. On Render, set these in Environment settings.

# --- Application ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of frontend URLs allowed to call the API (no trailing slash, no * in production)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BUSINESS_TIMEZONE=Asia/Karachi

# --- Database: Supabase Postgres connection string (server-side only) ---
# Supabase dashboard > Connect > "Session pooler" (works on IPv4 hosts such as Render).
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase Auth: used ONLY to verify users' access tokens ---
# Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Only for projects still using the legacy shared JWT secret (Project Settings > API > JWT Settings).
# Leave empty if your project uses the new JWT signing keys (verified automatically via SUPABASE_URL).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Google Gemini (Google AI Studio > Get API key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Limits ---
MAX_UPLOAD_SIZE_MB=5
AI_RATE_LIMIT_PER_MINUTE=20

# --- Local development only (refused when APP_ENV=production) ---
# true = call the API from Swagger without logging in, as a fixed local test user.
DEV_AUTH_BYPASS=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=dev@dukaandiary.local
