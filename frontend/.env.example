# Copy to `.env.local` (git-ignored) and fill in. Restart `npm run dev` after changes.
# Everything here is PUBLIC: Vite bundles VITE_ variables into browser JavaScript.
# Never put the Gemini key, database password, or a Supabase secret/service-role key here.

# Backend address INCLUDING the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project URL and the publishable (anon) key, used only for sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: "live" (default when the three values above are set) or "demo".
# "demo" opens the browser-only sample workspace and never contacts the backend for data.
VITE_APP_MODE=
